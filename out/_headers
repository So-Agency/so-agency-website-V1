# Cloudflare Pages response headers
#
# RFC 8288 Link headers pointing agents at machine-readable descriptions of the site.
# Every relation below is IANA-registered and resolves to a file that actually exists.
# Deliberately absent: rel="api-catalog" — this is a static site with no API. See
# AGENT-READINESS.md.
#
# Verified on deploy: Cloudflare Pages MERGES every matching rule, so the /* values below
# are already present on every locale page. The locale rules therefore only add what is
# specific to them — repeating the shared links there emits them twice.
# Within a single rule, keep all values on one comma-separated Link: line.

/*
  Link: </.well-known/ai-catalog.json>; rel="service-desc"; type="application/json", </llms.txt>; rel="service-doc"; type="text/plain", </.well-known/agent-skills/index.json>; rel="describedby"; type="application/json"
  X-Robots-Tag: index, follow

# hreflang stays off the Link headers on purpose: sitemap.xml carries the
# authoritative <xhtml:link hreflang=...> declarations for the three locales,
# and Lighthouse's hreflang audit was flagging the ones here, in particular
# the self-link that pointed at the markdown twin (type="text/markdown" with
# hreflang would describe a markdown document as a locale alternate, which it
# is not). The Link headers now only declare the markdown twin for agents
# that content-negotiate on it; locale discovery still works via sitemap.xml
# and via the <link> tags Next emits in <head>.
/en/*
  Link: </en/index.md>; rel="alternate"; type="text/markdown"

/es/*
  Link: </es/index.md>; rel="alternate"; type="text/markdown"

/fr/*
  Link: </fr/index.md>; rel="alternate"; type="text/markdown"

# ARD requires the catalog to be cross-origin readable. Content-Type is derived from
# the file extension by Cloudflare Pages (.json -> application/json).
/.well-known/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/llms.txt
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

# Content-hashed Next.js bundles - the filename changes on every build, so a
# cached copy can never serve stale content and the browser can keep it as
# long as it has disk space. "immutable" tells the browser not to even send a
# conditional request on page refresh. Cloudflare Pages' default of max-age=
# 14400 is correct but conservative; this unlocks the biggest repeat-visit win.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images and fonts live at stable paths (no content hash in the filename), so
# an in-place swap (as happened in commits 1a14a4c and 45baae7, when the hero
# and the three portfolio screenshots were resized) keeps the same URL. Under
# the previous max-age=2592000 the Cloudflare edge held onto the old bytes
# for 30 days after each swap and a manual purge was needed every time. The
# shorter max-age=86400 + must-revalidate below lets the browser cache for
# 24 h but forces a conditional request after that, which Cloudflare answers
# with a 304 (zero body) when the ETag still matches - near-zero cost for
# repeat visitors and automatic recovery from the next in-place resize.
/images/*
  Cache-Control: public, max-age=86400, must-revalidate

# Logo + favicon follow the same policy for the same reason: both are stable
# paths that have been edited in place before (logo.svg replaced logo.png in
# the navbar + footer in commit 980d28d).
/logo.svg
  Cache-Control: public, max-age=86400, must-revalidate

/favicon.png
  Cache-Control: public, max-age=86400, must-revalidate
